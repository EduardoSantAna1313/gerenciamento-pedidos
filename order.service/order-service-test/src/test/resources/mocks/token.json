{
  "request": {
    "method": "POST",
    "path": "/token",
    "body": "{ \"client_id\": \"my-client-id\", \"client_secret\": \"my-client-secret\" }",
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "response": {
    "statusCode": 201,
    "body": "{ \"access_token\": \"uuid\", \"expires_in\": 300, \"refresh_token\": \"token\" }"
  }
}
